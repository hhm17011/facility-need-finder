{
  "name": "facility-need-finder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && esbuild scripts/render-server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "start": "node dist-server/server.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.12",
    "typescript": "~5.7.3",
    "vite": "^6.4.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
